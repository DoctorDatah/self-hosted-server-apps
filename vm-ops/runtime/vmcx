#!/usr/bin/env python3
import argparse
import concurrent.futures as futures
import json
import subprocess
import sys
from pathlib import Path
from typing import Any, Dict, List

SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parent
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from runtime.lib.io_utils import ConfigError, load_data_file
from runtime.lib.resolve import (
    ResolutionError,
    build_plan,
    load_inventory,
    load_policy,
    render_exact_command,
    repo_root_from_script,
)
from runtime.lib.runner import RunError, cancel_run, execute_run, load_status, resume_run
from runtime.planner.plan import format_plan


def eprint(msg: str) -> None:
    print(msg, file=sys.stderr)


def _common_plan_run_args(p: argparse.ArgumentParser) -> None:
    p.add_argument("--target", help="target id")
    p.add_argument("--alias", help="friendly alias")
    p.add_argument("--stages", help="comma-separated stage ids")
    p.add_argument("--params", help="JSON params object", default="")
    p.add_argument("--exec-mode", default="auto", choices=["auto", "local", "ssh", "vm-local", "vm-remote-ssh"])


def cmd_plan(args: argparse.Namespace, repo_root: Path) -> int:
    inventory = load_inventory(repo_root)
    policy = load_policy(repo_root)
    plan = build_plan(
        repo_root=repo_root,
        inventory=inventory,
        policy=policy,
        target_id=args.target,
        alias_name=args.alias,
        stages_csv=args.stages,
        params_json=args.params,
        exec_mode=args.exec_mode,
        operation="plan",
    )
    print(format_plan(plan))
    print("\nexact_command:", render_exact_command({**plan, "operation": "run"}))
    return 0


def cmd_run(args: argparse.Namespace, repo_root: Path) -> int:
    if not args.confirm:
        raise RunError("run requires --confirm")

    inventory = load_inventory(repo_root)
    policy = load_policy(repo_root)
    plan = build_plan(
        repo_root=repo_root,
        inventory=inventory,
        policy=policy,
        target_id=args.target,
        alias_name=args.alias,
        stages_csv=args.stages,
        params_json=args.params,
        exec_mode=args.exec_mode,
        operation="run",
    )

    run_id = execute_run(plan, repo_root, confirm=True)
    print(json.dumps({"run_id": run_id, "status": "succeeded"}, indent=2))
    print(f"next: vmcx status --run-id {run_id}")
    print(f"next: vmcx resume --run-id {run_id}")
    print(f"next: vmcx cancel --run-id {run_id}")
    return 0


def _group_members(raw_group: Any) -> List[str]:
    if isinstance(raw_group, list):
        return [str(x) for x in raw_group]
    if isinstance(raw_group, dict):
        members = raw_group.get("members", [])
        if isinstance(members, list):
            return [str(x) for x in members]
    return []


def cmd_run_group(args: argparse.Namespace, repo_root: Path) -> int:
    if not args.confirm:
        raise RunError("run-group requires --confirm")

    inventory = load_inventory(repo_root)
    policy = load_policy(repo_root)

    group = inventory["groups"].get(args.group)
    if not group:
        raise ResolutionError(f"Unknown group: {args.group}")

    members = _group_members(group)
    if not members:
        raise ResolutionError(f"Group {args.group} has no members")

    results: List[Dict[str, Any]] = []

    def _run_one(target_id: str) -> Dict[str, Any]:
        try:
            plan = build_plan(
                repo_root=repo_root,
                inventory=inventory,
                policy=policy,
                target_id=target_id,
                alias_name=None,
                stages_csv=args.stages,
                params_json=args.params,
                exec_mode=args.exec_mode,
                operation="run",
            )
            run_id = execute_run(plan, repo_root, confirm=True)
            return {"target_id": target_id, "run_id": run_id, "status": "succeeded"}
        except Exception as exc:  # noqa: BLE001
            return {"target_id": target_id, "run_id": None, "status": "failed", "error": str(exc)}

    if args.concurrency <= 1:
        for member in members:
            results.append(_run_one(member))
    else:
        with futures.ThreadPoolExecutor(max_workers=args.concurrency) as pool:
            for item in pool.map(_run_one, members):
                results.append(item)

    print(json.dumps({"group": args.group, "results": results}, indent=2))
    return 1 if any(r["status"] == "failed" for r in results) else 0


def cmd_status(args: argparse.Namespace, repo_root: Path) -> int:
    status = load_status(repo_root, args.run_id)
    print(json.dumps(status, indent=2, sort_keys=True))
    return 0


def cmd_resume(args: argparse.Namespace, repo_root: Path) -> int:
    new_run_id = resume_run(repo_root, args.run_id, confirm=True)
    print(json.dumps({"resumed_from": args.run_id, "new_run_id": new_run_id}, indent=2))
    return 0


def cmd_cancel(args: argparse.Namespace, repo_root: Path) -> int:
    status = cancel_run(repo_root, args.run_id)
    print(json.dumps(status, indent=2, sort_keys=True))
    return 0


def cmd_list_targets(repo_root: Path) -> int:
    inventory = load_inventory(repo_root)
    rows = []
    for target_id, target in sorted(inventory["targets"].items()):
        rows.append(
            {
                "target_id": target_id,
                "environment": target.get("environment", ""),
                "exec_mode": target.get("exec_mode", ""),
                "groups": target.get("groups", []),
            }
        )
    print(json.dumps(rows, indent=2))
    return 0


def cmd_list_groups(repo_root: Path) -> int:
    inventory = load_inventory(repo_root)
    rows = []
    for name, group in sorted(inventory["groups"].items()):
        rows.append({"group": name, "members": _group_members(group)})
    print(json.dumps(rows, indent=2))
    return 0


def cmd_list_aliases(repo_root: Path) -> int:
    inventory = load_inventory(repo_root)
    rows = []
    for alias, data in sorted(inventory["aliases"].items()):
        rows.append(
            {
                "alias": alias,
                "target_selector": data.get("target_selector"),
                "default_stages": data.get("default_stages", []),
                "requires_confirmation": data.get("requires_confirmation", True),
                "description": data.get("description", ""),
            }
        )
    print(json.dumps(rows, indent=2))
    return 0


def _validate_structure(repo_root: Path) -> List[str]:
    errors: List[str] = []
    required_dirs = [
        "ai-skills",
        "runtime",
        "vm-setups",
        "apps",
        "vm-configs",
        "tools",
    ]
    for d in required_dirs:
        if not (repo_root / d).exists():
            errors.append(f"missing directory: {d}")

    required_config_files = [
        "vm-configs/vm-machines.yaml",
    ]
    for f in required_config_files:
        if not (repo_root / f).exists():
            errors.append(f"missing file: {f}")

    # Workflows may live in repo root or one level above when vm-ops is nested.
    local_workflows = repo_root / ".github" / "workflows"
    parent_workflows = repo_root.parent / ".github" / "workflows"
    if not local_workflows.exists() and not parent_workflows.exists():
        errors.append("missing directory: .github/workflows")
    return errors


def _tracked_local_app_data_files(repo_root: Path) -> List[str]:
    try:
        top = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=str(repo_root),
            capture_output=True,
            text=True,
            check=False,
        )
        top_root = Path((top.stdout or "").strip()).resolve() if top.returncode == 0 and (top.stdout or "").strip() else repo_root
        try:
            rel = repo_root.resolve().relative_to(top_root)
            rel_prefix = "" if str(rel) in {"", "."} else rel.as_posix().strip("/") + "/"
        except ValueError:
            rel_prefix = ""

        proc = subprocess.run(
            ["git", "ls-files"],
            cwd=str(repo_root),
            capture_output=True,
            text=True,
            check=False,
        )
    except Exception:
        return []
    if proc.returncode != 0:
        return []
    tracked = [str(x).strip() for x in (proc.stdout or "").splitlines() if str(x).strip()]
    prefixes = ["vm-managment-app/app-data/"]
    if rel_prefix:
        prefixes.append(f"{rel_prefix}vm-managment-app/app-data/")
    return [p for p in tracked if any(p.startswith(prefix) for prefix in prefixes)]


def _validate_references(repo_root: Path) -> List[str]:
    errors: List[str] = []
    tracked_local_app_data = _tracked_local_app_data_files(repo_root)
    if tracked_local_app_data:
        preview = ", ".join(tracked_local_app_data[:5])
        extra = "" if len(tracked_local_app_data) <= 5 else f" (+{len(tracked_local_app_data) - 5} more)"
        errors.append(
            "sensitive local app-data is tracked by git: "
            f"{preview}{extra}. Remove from index and keep ignored."
        )

    inventory = load_inventory(repo_root)

    # targets -> stage metadata references
    for target_id, target in inventory["targets"].items():
        enabled = target.get("enabled_stages", [])
        if not isinstance(enabled, list):
            errors.append(f"target {target_id} enabled_stages must be a list")
            continue

        if "params" in target and not isinstance(target.get("params"), dict):
            errors.append(f"target {target_id} params must be an object")
        if "defaults" in target and not isinstance(target.get("defaults"), dict):
            errors.append(f"target {target_id} defaults must be an object")

        for stage_id in enabled:
            stage_dir = repo_root / "vm-setups" / str(stage_id)
            if not stage_dir.exists():
                errors.append(f"target {target_id} references missing stage: {stage_id}")
                continue
            for required in ["stage.sh", "stage.yaml", "README.md"]:
                if not (stage_dir / required).exists():
                    errors.append(f"stage {stage_id} missing {required}")

    # groups
    for group_name, group in inventory["groups"].items():
        members = _group_members(group)
        if not members:
            errors.append(f"group {group_name} has no members")
        for target_id in members:
            if target_id not in inventory["targets"]:
                errors.append(f"group {group_name} references unknown target: {target_id}")

    # aliases
    for alias_name, alias in inventory["aliases"].items():
        selector = str(alias.get("target_selector", ""))
        if not selector.startswith("target_id="):
            errors.append(f"alias {alias_name} has unsupported target_selector")
            continue
        target_id = selector.split("=", 1)[1]
        if target_id not in inventory["targets"]:
            errors.append(f"alias {alias_name} references unknown target: {target_id}")

    # policies -> stages
    policy = load_policy(repo_root)
    rules = policy.get("rules", {})
    if not isinstance(rules, dict):
        errors.append("vm-configs/vm-env-rules.yaml: rules must be a map")
    else:
        for stage_id in rules.keys():
            if not (repo_root / "vm-setups" / str(stage_id)).exists():
                errors.append(f"policy references unknown stage: {stage_id}")

    # app contracts
    for app_file in sorted((repo_root / "apps").glob("*/app.yaml")):
        try:
            app = load_data_file(app_file)
        except ConfigError as exc:
            errors.append(str(exc))
            continue
        if "app_id" not in app:
            errors.append(f"{app_file}: missing app_id")

    return errors


def cmd_doctor(args: argparse.Namespace, repo_root: Path) -> int:
    errors = _validate_structure(repo_root)

    try:
        errors.extend(_validate_references(repo_root))
    except Exception as exc:  # noqa: BLE001
        errors.append(str(exc))

    result = {
        "repo_root": str(repo_root),
        "errors": errors,
        "status": "ok" if not errors else "failed",
    }
    print(json.dumps(result, indent=2))

    if errors:
        return 1
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="vmcx", description="vm-codex-v2 runtime CLI")
    sub = parser.add_subparsers(dest="command", required=True)

    p_plan = sub.add_parser("plan", help="preview execution plan")
    _common_plan_run_args(p_plan)

    p_run = sub.add_parser("run", help="execute stages")
    _common_plan_run_args(p_run)
    p_run.add_argument("--confirm", action="store_true")

    p_group = sub.add_parser("run-group", help="execute stages for a group")
    p_group.add_argument("--group", required=True)
    p_group.add_argument("--stages", required=True)
    p_group.add_argument("--params", default="")
    p_group.add_argument("--exec-mode", default="auto", choices=["auto", "local", "ssh", "vm-local", "vm-remote-ssh"])
    p_group.add_argument("--concurrency", type=int, default=1)
    p_group.add_argument("--confirm", action="store_true")

    p_status = sub.add_parser("status", help="show run status")
    p_status.add_argument("--run-id", required=True)

    p_resume = sub.add_parser("resume", help="resume a failed run")
    p_resume.add_argument("--run-id", required=True)

    p_cancel = sub.add_parser("cancel", help="mark a run canceled")
    p_cancel.add_argument("--run-id", required=True)

    sub.add_parser("list-targets", help="list targets")
    sub.add_parser("list-groups", help="list groups")
    sub.add_parser("list-aliases", help="list aliases")

    p_doctor = sub.add_parser("doctor", help="validate runtime config")
    p_doctor.add_argument("--ci", action="store_true", help="strict mode for CI")
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    repo_root = repo_root_from_script(Path(__file__))

    try:
        if args.command == "plan":
            return cmd_plan(args, repo_root)
        if args.command == "run":
            return cmd_run(args, repo_root)
        if args.command == "run-group":
            return cmd_run_group(args, repo_root)
        if args.command == "status":
            return cmd_status(args, repo_root)
        if args.command == "resume":
            return cmd_resume(args, repo_root)
        if args.command == "cancel":
            return cmd_cancel(args, repo_root)
        if args.command == "list-targets":
            return cmd_list_targets(repo_root)
        if args.command == "list-groups":
            return cmd_list_groups(repo_root)
        if args.command == "list-aliases":
            return cmd_list_aliases(repo_root)
        if args.command == "doctor":
            return cmd_doctor(args, repo_root)
        parser.print_help()
        return 2
    except (ConfigError, ResolutionError, RunError) as exc:
        eprint(f"error: {exc}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
