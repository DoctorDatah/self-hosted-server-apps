#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
from typing import Any, Dict, List
from concurrent.futures import ThreadPoolExecutor, as_completed

from lib.config import resolve_effective_config
from lib.executor import execute_plan
from lib.inventory import (
    get_alias,
    get_target,
    list_aliases,
    list_groups,
    list_targets,
    load_inventory,
    resolve_alias_selector,
    resolve_group_targets,
)
from lib.planner import build_plan
from lib.state import ensure_dirs, load_run, new_run_id, now, save_run


def parse_stages(stages_raw: str | None, alias_item: Dict[str, Any] | None) -> List[str]:
    if stages_raw:
        return [s.strip() for s in stages_raw.split(",") if s.strip()]
    if alias_item:
        return list(alias_item.get("default_stages", []))
    raise ValueError("stages are required")


def parse_params(params_raw: str | None) -> Dict[str, Any]:
    if not params_raw:
        return {}
    return json.loads(params_raw)


def summarize_plan(plan: Dict[str, Any]) -> str:
    lines: List[str] = []
    lines.append(f"Target: {plan['target'].get('target_id')}")
    lines.append(f"Stages: {', '.join(plan['stages'])}")
    lines.append("Config sources:")
    for src in plan["effective_config_sources"]:
        lines.append(f"  - {src}")
    lines.append("Requirements sources:")
    for src in plan["effective_requirements_sources"]:
        lines.append(f"  - {src}")
    lines.append("Commands:")
    for stage in plan["stage_plans"]:
        lines.append(f"  [{stage['stage']}] risk={stage['risk']}")
        for cmd in stage["commands"]:
            lines.append(f"    $ {cmd}")
    if plan["preflight_failed"]:
        lines.append("Preflight: FAILED")
    else:
        lines.append("Preflight: OK")
    return "\n".join(lines)


def make_run_record(run_id: str, target: Dict[str, Any], plan: Dict[str, Any], mode: str) -> Dict[str, Any]:
    return {
        "run_id": run_id,
        "target_id": target.get("target_id"),
        "group": None,
        "mode": mode,
        "state": "queued",
        "created_at": now(),
        "started_at": None,
        "finished_at": None,
        "stages": plan["stages"],
        "stage_plans": plan["stage_plans"],
        "stage_results": [],
        "completed_stages": [],
        "cancellation_requested": False,
        "error_class": None,
        "plan_summary": summarize_plan(plan),
    }


def handle_plan(root: Path, target: Dict[str, Any], stages: List[str], cli_params: Dict[str, Any], alias_defaults: Dict[str, Any] | None = None) -> Dict[str, Any]:
    merged = resolve_effective_config(root, target, alias_defaults=alias_defaults)
    plan = build_plan(root, target, stages, merged, cli_params=cli_params)
    return {
        "status": "planned",
        "target_id": target.get("target_id"),
        "stages": stages,
        "preflight_failed": plan["preflight_failed"],
        "summary": summarize_plan(plan),
        "plan": plan,
    }


def handle_run(
    root: Path,
    target: Dict[str, Any],
    stages: List[str],
    cli_params: Dict[str, Any],
    *,
    confirm: bool,
    dry_run: bool,
    alias_defaults: Dict[str, Any] | None = None,
) -> Dict[str, Any]:
    planned = handle_plan(root, target, stages, cli_params, alias_defaults=alias_defaults)
    plan = planned["plan"]

    if plan["preflight_failed"]:
        return {
            "status": "failed",
            "error_class": "preflight_mismatch",
            "target_id": target.get("target_id"),
            "summary": planned["summary"],
        }

    if not confirm:
        return {
            "status": "blocked",
            "error_class": "confirmation_required",
            "target_id": target.get("target_id"),
            "summary": planned["summary"],
        }

    run_id = new_run_id()
    run = make_run_record(run_id, target, plan, mode="apply")
    save_run(root, run)
    run = execute_plan(root, run, dry_run=dry_run)

    return {
        "status": run["state"],
        "run_id": run_id,
        "target_id": target.get("target_id"),
        "error_class": run.get("error_class"),
        "summary": run["plan_summary"],
    }


def handle_run_group(
    root: Path,
    targets: List[Dict[str, Any]],
    stages: List[str],
    cli_params: Dict[str, Any],
    *,
    concurrency: int,
    confirm: bool,
    dry_run: bool,
) -> Dict[str, Any]:
    if not confirm:
        return {
            "status": "blocked",
            "error_class": "confirmation_required",
            "summary": f"Group run blocked; {len(targets)} targets selected.",
        }

    summary_items: List[Dict[str, Any]] = []

    def _one(target: Dict[str, Any]) -> Dict[str, Any]:
        return handle_run(root, target, stages, cli_params, confirm=True, dry_run=dry_run)

    with ThreadPoolExecutor(max_workers=max(1, concurrency)) as pool:
        futures = {pool.submit(_one, t): t for t in targets}
        for future in as_completed(futures):
            t = futures[future]
            try:
                result = future.result()
            except Exception as exc:  # pragma: no cover
                result = {
                    "status": "failed",
                    "target_id": t.get("target_id"),
                    "error_class": "target_unreachable",
                    "summary": str(exc),
                }
            summary_items.append(result)

    failures = [item for item in summary_items if item.get("status") != "succeeded"]
    return {
        "status": "succeeded" if not failures else "failed",
        "mode": "group",
        "total": len(summary_items),
        "failed": len(failures),
        "items": sorted(summary_items, key=lambda x: x.get("target_id", "")),
    }


def main() -> int:
    root = Path(__file__).resolve().parents[2]
    ensure_dirs(root)
    inventory = load_inventory(root)

    parser = argparse.ArgumentParser(description="vm-codex local runtime")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_plan = sub.add_parser("plan")
    p_plan.add_argument("--target")
    p_plan.add_argument("--alias")
    p_plan.add_argument("--stages")
    p_plan.add_argument("--params")

    p_run = sub.add_parser("run")
    p_run.add_argument("--target")
    p_run.add_argument("--alias")
    p_run.add_argument("--stages")
    p_run.add_argument("--params")
    p_run.add_argument("--confirm", action="store_true")
    p_run.add_argument("--dry-run", action="store_true")

    p_group = sub.add_parser("run-group")
    p_group.add_argument("--group", required=True)
    p_group.add_argument("--stages")
    p_group.add_argument("--params")
    p_group.add_argument("--concurrency", type=int, default=2)
    p_group.add_argument("--confirm", action="store_true")
    p_group.add_argument("--dry-run", action="store_true")

    sub.add_parser("list-targets")
    sub.add_parser("list-groups")
    sub.add_parser("list-aliases")

    p_status = sub.add_parser("status")
    p_status.add_argument("--run-id", required=True)

    p_resume = sub.add_parser("resume")
    p_resume.add_argument("--run-id", required=True)

    p_cancel = sub.add_parser("cancel")
    p_cancel.add_argument("--run-id", required=True)

    args = parser.parse_args()

    if args.cmd == "list-targets":
        print(json.dumps({"items": list_targets(inventory)}, indent=2))
        return 0

    if args.cmd == "list-groups":
        print(json.dumps({"items": list_groups(inventory)}, indent=2))
        return 0

    if args.cmd == "list-aliases":
        print(json.dumps({"items": list_aliases(root)}, indent=2))
        return 0

    if args.cmd == "status":
        run = load_run(root, args.run_id)
        print(json.dumps(run, indent=2))
        return 0

    if args.cmd == "cancel":
        run = load_run(root, args.run_id)
        run["cancellation_requested"] = True
        if run["state"] not in {"succeeded", "failed", "canceled"}:
            run["state"] = "canceled"
            run["finished_at"] = now()
        save_run(root, run)
        print(json.dumps({"status": run["state"], "run_id": run["run_id"]}, indent=2))
        return 0

    if args.cmd == "resume":
        run = load_run(root, args.run_id)
        if run["state"] not in {"failed", "canceled"}:
            print(json.dumps({"status": "blocked", "message": f"Run in state {run['state']} cannot be resumed."}, indent=2))
            return 1

        target = get_target(inventory, run["target_id"])
        completed = set(run.get("completed_stages", []))
        remaining = [stage for stage in run.get("stages", []) if stage not in completed]
        if not remaining:
            print(json.dumps({"status": "succeeded", "run_id": run["run_id"], "message": "No remaining stages"}, indent=2))
            return 0

        resume_params: Dict[str, Any] = {}
        for stage in run.get("stage_plans", []):
            name = stage.get("stage")
            if name in remaining and stage.get("params"):
                resume_params[name] = stage["params"]

        result = handle_run(root, target, remaining, resume_params, confirm=True, dry_run=False)
        print(json.dumps(result, indent=2))
        return 0

    if args.cmd == "run-group":
        targets = resolve_group_targets(inventory, args.group)
        stages = parse_stages(args.stages, None)
        params = parse_params(args.params)
        out = handle_run_group(
            root,
            targets,
            stages,
            params,
            concurrency=args.concurrency,
            confirm=args.confirm,
            dry_run=args.dry_run,
        )
        print(json.dumps(out, indent=2))
        return 0

    # plan/run alias/target resolution
    alias_item = None
    alias_defaults = None
    if getattr(args, "alias", None):
        alias_item = get_alias(root, args.alias)
        alias_defaults = alias_item
        selector_result = resolve_alias_selector(inventory, alias_item["target_selector"])
        if selector_result["mode"] == "group":
            if args.cmd == "plan":
                print(json.dumps({"status": "blocked", "message": "Use run-group for group aliases."}, indent=2))
                return 1
            targets = selector_result["targets"]
            stages = parse_stages(args.stages, alias_item)
            params = parse_params(args.params)
            out = handle_run_group(
                root,
                targets,
                stages,
                params,
                concurrency=2,
                confirm=getattr(args, "confirm", False),
                dry_run=getattr(args, "dry_run", False),
            )
            print(json.dumps(out, indent=2))
            return 0
        target = selector_result["targets"][0]
    else:
        if not getattr(args, "target", None):
            print(json.dumps({"status": "failed", "error_class": "target_required"}, indent=2))
            return 1
        target = get_target(inventory, args.target)

    if args.cmd == "plan":
        stages = parse_stages(args.stages, alias_item)
        params = parse_params(args.params)
        out = handle_plan(root, target, stages, params, alias_defaults=alias_defaults)
        print(json.dumps({k: v for k, v in out.items() if k != "plan"}, indent=2))
        return 0

    if args.cmd == "run":
        stages = parse_stages(args.stages, alias_item)
        params = parse_params(args.params)
        out = handle_run(
            root,
            target,
            stages,
            params,
            confirm=args.confirm,
            dry_run=args.dry_run,
            alias_defaults=alias_defaults,
        )
        print(json.dumps(out, indent=2))
        return 0

    return 1


if __name__ == "__main__":
    raise SystemExit(main())
